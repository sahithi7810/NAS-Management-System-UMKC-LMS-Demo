import os
from werkzeug.utils import secure_filename

STORAGE_FOLDER = os.path.realpath(
    os.path.join(
        os.path.dirname(os.path.dirname(os.path.abspath(__file__))),
        "storage"
    )
)


os.makedirs(STORAGE_FOLDER, exist_ok=True)

def _safe_path(relative_path=""):
    """Validate paths and keep access inside NAS storage."""
    if not isinstance(relative_path, str):
        raise ValueError("Invalid path.")
    relative_path = relative_path.replace("\\","/")
    if relative_path.startswith("/") or "\x00" in relative_path:
        raise ValueError("Invalid path.")
    parts = relative_path.split("/")
    if any(part == ".." for part in parts):
        raise ValueError("Invalid path.")
    parts = [part for part in parts if part not in ("", ".")]
    root = os.path.realpath(STORAGE_FOLDER)
    target = os.path.join(root, *parts)

    current = root
    for part in parts:
        current = os.path.join(current, part)
        if os.path.islink(current):
            raise ValueError("Symbolic links are not allowed.")
    target = os.path.realpath(target)
    if os.path.commonpath([root, target]) != root:
        raise valueError("Inavlid storage location.")
    return target, "/".join(parts)

def upload_file(file, relative_path=""):
    """Upload a file into the selected folder."""
    if not file or not file.filename:
        return False

    filename = secure_filename(file.filename)
    if not filename:
        return False
    try:
        directory,_=_safe_path(relative_path)
        if not os.path.isdir(directory):
            return False
        destination = os.path.join(directory, filename)
        if os.path.lexists(destination):
            return False
        file.save(destination)
        return True
    except (valueError, OSError):
        return False


def get_all_files(relative_path=""):
    """List files and folders in a directory."""
    directory, current_path = _safe_path(relative_path)
    if not os.path.isdir(directory):
        raise FileNotFoundError("Folder not found.")
    items = []
    with os.scandir(directory) as entries:
        for entry in entries:
            if entry.is_symlink():
                continue
            item_path = "/".join(
                 part for part in (current_path, entry.name) if part
            )
            if entry.is_dir(follow_symlinks=False):
                items.append({
                    "name": entry.name,
                    "size": "Folder",
                    "is_dir": True,
                    "path": item_path
                })
            elif entry.is_file(follow_symlinks=False):
                size_kb = round(
                    entry.stat(follow_symlinks=False).st_size / 1024,
                    2
                )
                items.append({
                    "name": entry.name,
                    "size": size_kb,
                    "is_dir": False,
                    "path": item_path
                })
    items.sort(key=lambda item: (not item["is_dir"], item["name"].lower()))
    return items
    
def create_folder(folder_name, relative_path=""):
    """create a new folderin the selected directory."""
    folder_name = folder_name.strip()
    if (
        not folder_name
        or "/" in folder_name
        or "\\" in folder_name
        or folder_name in (".", "..")
    ):
        return False, "Invalid folder name."
    safe_name = secure_filename(folder_name)
    if not safe_name:
        return false, "Invalid folder name."
    try:
        directory,_=_safe_path(relative_path)
        if not os.path.isdir(directory):
            return false, "Parent folder not found."
        os.mkdir(os.path.join(directory, safe_name))
        return True, f"Folder '{safe_name}' created successfully."
    except FileExistsError:
        return False, "A file or folder with this name already exists."
    except (ValueError, OSError):

        return false, "Unable to create folder."


def delete_file(relative_path):
    """Delete an existing file."""
    try:
        file_path, _=_safe_path(relative_path)
        if not os.path.isfile(file_path):
            return False
        os.remove(file_path)
        return True
    except (ValueError, OSError):
        return False

def get_file_path(relative_path):
    """Get a validated path to an existing file."""
    try:
        file_path, _=_safe_path(relative_path)
        if not os.path.isfile(file_path):
            return None
        return file_path
    except (ValueError, OSError):
        return None
def rename_item(relative_path, new_name):
    """Rename a file or folder safely."""
    new_name = new_name.strip()
    if (
        not new_name
        or new_name in (".", "..")
        or "/" in new_name
        or "\\" in new_name
        or "\x00" in new_name
        or len(new_name) > 255
    ):
       return False, "Invalid new name."
    try:
        source, normalized_path = _safe_path(relative_path)
        if not normalized_path:
            return false, "Cannot rename main storage."
        if not os.path.lexists(source):
            return False, "File or folder not found."
        parent = os.path.dirname(source)
        destination = os.path.join(parent, new_name)
        if os.path.lexists(destination):
            return False, "A file or folder with this name already exists."
        os.rename(source, destination)
        return True, f"Renamed successfully to '{new_name}'."
    except (ValueError, OSError):
        return False, "Unable to rename file or folder." 


def delete_folder(relative_path):
    """Delete an empty folder safely inside NAS storage."""
    try:
        folder_path, normalized_path = _safe_path(relative_path)
        if not normalized_path:
             return False, "Cannot delete the main storage folder."
        if not os.path.isdir(folder_path):
            return False, "Folder not found."
        os.rmdir(folder_path)
        return True, "Folder deleted successfully."
    except ValueError:
        return False, "Invalid folder path."
    except OSError:
        return False, "Folder is not empty or cannot be deleted."

