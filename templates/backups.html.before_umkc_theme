<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>NAS Backup Management</title>
    <link 
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet">
</head>
<body class="bg-light">
<nav class="navbar navbar-dark bg-primary px-4">
    <span class="navbar-brand">NAS Backup & Restore</span>
    <a href="{{ url_for('dashboard') }}"
       class="btn btn-light">
        back to Dashboard
    </a>
</nav>
<div class="container mt-5">
    <h2>Backup & Restore Management</h2>
    <p class="text-muted">
        Create, download, restore and manage NAS backups.
    </p>
    {% with messages = get_flashed_messages(with_categories=true) %}
        {% for category, message in messages %}
            <div class="alert alert-{{ category }}">
                {{ message }}
            </div>
        {% endfor %}
    {% endwith %}
    <div class="card shadow-sm p-4 mb-4">
        <h5>Create New Backup</h5>
        <p>Create a compressed backup of your NAS storage.</p>
        <form action="{{ url_for('backup_create') }}"
              method="POST">
            <button type="submit" class="btn btn-primary">
                Create Backup
            </button>
        </form>
    </div>
    <div class="card shadow-sm p-4">
        <h5>Available Backup Archives</h5>
        {% if backups %}
        <div class="table-responsive mt-3">
            <table class="table table-bordered table-striped">
                <thead class="table-primary">
                    <tr>
                        <th>Backup Filename</th>
                        <th>Size (KB)</th>
                        <th>Created At</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for backup in backups %}
                    <tr>
                        <td>{{ backup.name }}</td>
                        <td>{{ backup.size_kb }}</td>
                        <td>{{ backup.created_at }}</td>
                        <td>
                            <div class="d-flex gap-2 flex-wrap">
                                <a href="{{ url_for(
                                    'backup_download',
                                    filename=backup.name
                                ) }}"
                                   class="btn btn-success btn-sm">
                                    Download
                                </a>
                                <form 
                                    action="{{ url_for(
                                        'backup_restore',
                                        filename=backup.name
                                    ) }}"
                                    method="POST"
                                    onsubmit="return confirm(
                                        'Restore this backup? Matching existing file may be overwritten.'
                                    );">
                                    <button type="submit"
                                            class="btn btn-warning btn-sm">
                                         Restore
                                    </button>
                                </form>
                                <form
                                    action="{{ url_for(
                                        'backup_delete',
                                         filename=backup.name
                                    ) }}"
                                    method="POST"
                                    onsubmit="return confirm(
                                        'Are you sure you want to delete this backup?'
                                    );">
                                    <button type="submit"
                                            class="btn btn-danger btn-sm">
                                        Delete
                                    </button>
                                </form>
                            </div> 
                        </td>   
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
         {% else %}
             <div class="alert alert-info mt-3">
                 No backup archives are available.
             </div>
         {% endif %}
     </div>
     <p class="text-muted mt-4">
         NAS Backup Management System
     </p>
 </div>
</body>
</html>

