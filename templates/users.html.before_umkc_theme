<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>NAS User Management</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light">
<nav class="navbar nabvar-dark bg-primary px-4">
    <span class="navbar-brand">NAS User Management</span>
    <a href="{{ url_for('dashboard') }}" class="btn btn-light">
        Back to Dashboard
    </a>
</nav>
<div class="container mt-5">

    <h2>User Management</h2>
    <p class="text-muted">Manage resistered NAS accounts.</p>

    <div class="card shadow-sm mt-4">
        <div class="card-body">
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h5 class="mb-3">Create New User</h5>
                <form action="{{ url_for('add_user') }}" method="POST">
                    <div class="mb-3">
                        <label class="form-label">Username</label>
                        <input type="text" name="username"
                               class="form-control"
                               placeholder="Enter a new username"
                               required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input type="email" name="email"
                               class="form-control"
                               placeholder="Enter a new email"
                               required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Password</label>
                        <input type="password" name="password"
                               class="form-control"
                               placeholder="Enter password"
                               minlength="8"
                               required>
                        <small class="text-muted">
                            Minimum 8 characters.
                        </small>
                    </div>
                    <button type="submit" class="btn btn-primary">
                        Create User
                    </button>
                </form>
            </div>
        </div>

            <h5 class="mb-3">Registered Users</h5>
            <div class="table-reponsive">
                <table class="table table-bordered table-striped">
                    <thead class="table-primary">
                        <tr>
                            <th>User ID</th>
                            <th>Username</th>
                            <th>Email</th>
                            <th>Role</th>
                            <th>Status</th>
                            <th>Actions</th>
                            <th>Created At</th>
                        </tr>
                    </thead>


                    <tbody>
                        {% for user in users %}
                        <tr>
                            <td>{{ user.id }}</td>
                            <td>{{ user.username }}</td>
                            <td>{{ user.email or "Not provided" }}</td>
                            
                            <td>
                                {% if user.username == session.get('username') %}
                                    <span class="badge bg-primary">
                                        {{ user.role }}
                                    </span>
                                {% else %}
                                    <form
                                        action="{{ url_for('change_user_role', user_id=user.id) }}"
                                        method="POST"
                                        class="d-flex gap-2">
                                        <select name="role" class="form-select form-select-sm">
                                            <option value="user"
                                                {% if user.role == 'user' %}selected{% endif %}>
                                                Normal User
                                            </option>
                                            <option value="admin"
                                                {% if user.role == 'admin' %}selected{% endif %}>
                                                Administrator
                                            </option>
                                        </select>

                                        <button type="submit"
                                                class="btn btn-primary btn-sm">
                                            Save
                                        </button>
                                    </form>
                                {% endif %}
                            </td>
                            <td>
                                {% if user.is_active %}
                                    <span class="badge bg-success">Active</span>
                                {% else %}
                                    <span class="badge bg-danger">Inactive</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if user.username !=session.get('username') %}
                                    <form
                                        action="{{ url_for('change_user_status', user_id=user.id) }}"
                                        method="POST">
                                        {% if user.is_active %}
                                            <input type="hidden" name="action" value="deactivate">
                                            <button type="submit" class="btn btn-warning btn-sm">
                                                Deactivate
                                            </button>
                                        {% else %}
                                            <input type="hidden" name="action" value="activate">
                                            <button type="submit" class=btn btn-success btn-sm">
                                                Activate
                                            </button>
                                        {% endif %}
                                    </form>
                                    <form
                                        action="{{ url_for('remove_user', user_id=user.id) }}"
                                        method="POST"
                                        class="mt-2"
                                        onsubmit="return confirm('Are you sure you want to delete this user');">
                                        {% if user.username != session.get('username') %}
                                            <button type="submit" class="btn btn-danger btn-sm">
                                                Delete
                                            </button>
                                        {% endif %}
                                    </form>
                                    <form
                                        action="{{ url_for('edit_user', user_id=user.id) }}"
                                        method="POST"
                                        class="mt-3">
                                        <label class="form-label">Edit Username</label>
                                        <input
                                            type="text"
                                            name="username"
                                            value="{{ user.username }}"
                                            class="form-control form-control-sm mb-2"
                                            maxlength="100"
                                            required>
                                        <label class="form-label">Edit Email</label>
                                        <input 
                                            type="email"
                                            name="email"
                                            value="{{ user.email or ' ' }}"
                                            class="form-control form-control-sm mb-2"
                                            max length="150"
                                            required>
                                        <button type="submit" class="btn btn-info btn-sm">
                                            Save Details
                                        </button>
                                    </form>   
                    
                                {% else %}
                                    <span class="text-muted">Current account</span>
                                {% endif %}
                            </td>
                            <td>{{ user.created_at }}</td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="7" class="text-center">
                                 No registered users found.
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>

                </table>
            </div>

        </div>
    </div>

</div>
</body>
</html>

