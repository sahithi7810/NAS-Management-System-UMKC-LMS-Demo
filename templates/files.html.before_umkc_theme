
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, intitial-scale=1">
    <tittle>NAS File Management</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
<nav class="navbar navbar-dark bg-primary px-4">
    <span class="navbar-brand">NAS File management</span>
    <a href="{{ url_for('dashboard') }}" class="btn btn-light">
        Back to Dashboard
    </a>
</nav>
<div class="container mt-4">
    <h2>File Management</h2>
    <p class="text-muted">
        Upload, dowload and organize NAS files and folders.
    </p>
    
    {% with messages = get_flashed_messages() %}
        {% for message in messages %}
            <div class="alret alret-info">{{ message }}</div>
        {% endfor %}
    {% endwith %}
<div class="card shadow-sm p-3 mb-4"
    <h5>Current Location</h5>
    <p>
      <strong>Stronge /</strong>
      {% if current_path %}
          {{ current_path }}
      {% else %}
          Home
      {% endif %}
    </p>
    {% if current_path %}
        <a href="{{ url_for('files', path=parent_path) }}"
           class="btn btn-outline-secondary btn-sm">
            Back to parent Folder
        </a>
        <a href="{{ url_for('recycle_bin_page') }}"
           class="btn btn-secondary">
            Recycle Bin
        </a>
    {% endif %}
    <a href="{{ url_for('files') }}"
       class="btn btn-outline-primary btn-sm mt-2">
        Main Storage
    </a>
</div>
<div class="card shadow-sm p-3 mb-4">
    <h5>Create New Folder</h5>
    <form action="{{ url_for('create_folder_route') }}"
          method="POST">
        <input type="hidden"
               name="current-path"
               value="{{ current_path }}">
        <div class="mb-3">
            <label class="form-label">Folder Name </label>
            <input type="text"
                   name="folder_name"
                   class="form-control"
                   maxlength="100"
                   placeholder="Enter folder name"
         </div>
         <button type="submit" class="btn btn-primary">
             Create Folder
         </button>
     </form>
 </div>
 <div class="card shadow-sm p-3 mb-4">
     <h5>Upload File</h5>
     <form action="{{ url_for('files') }}"
           method="POST"
           enctype="multipart/form-data">
         <input type="hidden"
                name="current_path"
                value="{{ current_path }}">
         <div class="mb-3">
             <input type="file"
                    name="file"
                    class="form-control"
                    required>
         </div>
         <button type="submit" class="btn btn-success">
             upload File
         </button>
     </form>
 </div>
 <div class="card shadow-sm p-3 mb-4">
     <h5>Stored Files and Folders</h5>
     <div class="table-responsive">
         <table class="table table-striped table-bordered align-middle">
             <thead class="table-primary">
                 <tr> 
                     <th>Name</th>
                     <th>Type / Size</th>
                     <th>Actions</th>
                 </tr>
             </thead>
             <tbody>
                  {% for file in files %}
                      <tr>
                          <td>
                              {% if file.is_dir %}
                                  <a href="{{ url_for('files', path=file.path) }}">
                                      {{ file.name }}
                                  </a>
                              {% else %}
                                      {{ file.name }}
                              {% endif %}
                          </td>
                          <td>
                              {% if file.is_dir %}
                                  Folder
                              {% else %}
                                  {{ file.size }} KB
                              {% endif %}
                          </td>
                          <td>
                              {% if file.is_dir %}
                                  <a href="{{ url_for('files', path=file.path) }}"
                                     class="btn btn-primary btn-sm">
                                      Open Folder
                                  </a>
                                  <form action="{{ url_for('delete_folder_route') }}"
                                        method="POST"
                                        class="d-inline mt-2"
                                        onsubmit="return confirm('Deletethis empty folder?');">
                                      <input type="hidden"
                                             name="folder_path"
                                             value="{{ file.path }}">
                                      <input type="hidden"
                                             name="current_path"
                                             value="{{ current_path }}">
                                      <button type="submit"
                                              class="btn btn-danger btn-sm">
                                           Delete Empty Folder
                                      </button>
                                  </form>

                              {% else %}
      
                                  <a href="{{ url_for('download', filename=file.path) }}"
                                     class="btn btn-success btn-sm">
                                      Download

                                  </a>
                                  <form
                                      action="{{ url_for('delete', filename=file.path) }}"
                                      method="POST"
                                      class="d-inline"
                                      onsubmit="return confirm('Delete this file?');">
                                      <button type="submit"
                                              class="btn btn-danger btn-sm">
                                          Delete
                                      </button>
                                  </form>
                              {% endif %}
                              <form action="{{ url_for('rename_item_route') }}"
                                    method="POST"
                                    class="mt-2">
                                  <input type="hidden"
                                         name="old_path"
                                         value="{{ file.path }}">
                                  <input type="hidden"
                                         name="current_path"
                                         value="{{ current_path }}">
                                  <input type="text"
                                         name="new_name"
                                         class="form-control form-control-sm mb-2"
                                         placeholder="Enter new name"
                                         maxlength="255"
                                         required>
                                  <button type="submit"
                                          class="btn btn-warning btn-sm">
                                      Rename
                                  </button>
                              </form>
                               
                              {% if not file.is_dir %}
                              <a href="{{ url_for('manage_file_shares', filename=file.path) }}"
                                 class="btn btn-info btn-sm mt-2">
                                  Share / Manage Access
                              </a>
                              {% endif %}

                              {% if not file.is_dir %}

                              <a href="{{ url_for('manage_file_shares', filename=file.path) }}"
                                 class="btn btn-info btn-sm mt-2">
                                  Share / Manage Access
                              </a>

                              {% endif %}
                          </td>
                      </tr>
                  {% else %}
                      <tr> 
                          <td colspan="3"
                              class="text-center text-muted">
                              No files or folders found.
                          </td>
                      </tr>
                  {% endfor %}
              </tbody>
          </table>
      </div>
  </div>
</div>
</body>
</html>
