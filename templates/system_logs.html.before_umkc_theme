<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>NAS System Logs</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">
    <style>
        .log-window {
            background: #151515;
            color: #e8e8e8;
            padding: 18px;
            border-radius: 8px;
            max-height: 600px;
            overflow-y: auto;
            overflow-wrap: anywhere;
            white-space: pre-wrap;
            font-size: 13px;
        }
        .log-line {
            display: block;
            padding: 3px 0;
            border-bottom: 1px solid #333;
        }
    </style>
</head>
<body class="bg-light">
    <nav class="navbar navbar-dark bg-primary px-4">
        <span class="navbar-brand">NAS System Logs</span>
        <a href="/dashboard" class="btn btn-light">Back to Dashboard</a>
    </nav>
    <main class="container mt-4">
        <h2>Server Logs</h2>
        <p class="text-muted">
            Latest 200 entries from the NAS application log.
        </p>
        <div class="mb-3">
            <a href="/system-logs" class="btn btn-primary">
                Refresh Logs
            </a>
        </div>
        <div class="card shadow-sm p-3">
            {% if log_entries %}
                <div class="log-window">
                    {% for entry in log_entries %}
                        <span class="log-line">{{ entry }}</span>
                    {% endfor %}
                </div>
            {% else %}
                <div class="alert alert-info mb-0">
                    No log entries found yet.
                </div>
            {% endif %}
        </div>
    </main>
</body>
</html>
